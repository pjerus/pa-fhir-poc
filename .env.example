# --- Extraction (M1) -------------------------------------------------------
# Local Ollama endpoint used by src/extract/llm-client.ts. There is no cloud fallback.
OLLAMA_URL=http://localhost:11434
# Ollama tag to run extraction with. Tags are matched literally, including case.
EXTRACTION_MODEL=qwen3.8:27b

# --- Graph (M2) ------------------------------------------------------------
# Point these at whichever Neo4j holds this POC's database. Two supported paths:
#   * docker-compose.yml — a dedicated Community container (one database per
#     instance, so the POC gets its own container rather than an extra database).
#   * Neo4j Desktop — bundles Enterprise, so the POC database can be created
#     alongside others in one instance; set NEO4J_DATABASE to that name.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pafhirpoc-dev
NEO4J_DATABASE=pafhirpoc

# --- Review workflow (M3) --------------------------------------------------
# A fresh clone runs `temporal server start-dev` (namespace "default"). If a
# shared Temporal already occupies :7233, create a dedicated namespace instead:
#   temporal operator namespace create pa-fhir-poc
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=pa-fhir-review

# --- Review console UI -----------------------------------------------------
# Port for `node src/ui/server.ts` (binds to 127.0.0.1 only).
UI_PORT=8006
