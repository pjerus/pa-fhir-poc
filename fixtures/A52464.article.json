  "denialReasons": [
    {
      "id": "A52464-D1",
      "text": "CGM devices that solely display results on a smartphone and do not have a stand-alone receiver or integration into an insulin infusion pump do not meet the definition of DME and will be denied as non-covered (no benefit)."
    },
    {
      "id": "A52464-D2",
      "text": "Supplies or accessories billed separately will be denied as unbundling."
    },
    {
      "id": "A52464-D3",
      "text": "Separate billing of CGM sensors and transmitters will be denied as unbundling."
    },
    {
      "id": "A52464-D4",
      "text": "If a beneficiary never uses a DME receiver or insulin infusion pump to display CGM glucose data, the supply allowance is not covered by Medicare."
    },
    {
      "id": "A52464-D5",
      "text": "Smart devices are non-covered by Medicare because they do not meet the definition of DME (i.e., not primarily medical in nature and are useful in the absence of illness)."
    },
    {
      "id": "A52464-D6",
      "text": "If a CGM system is billed using HCPCS E2102 or E2103 but the CGM system is not on the PCL for the particular HCPCS code, then the claim will be denied as incorrect coding."
    },
    {
      "id": "A52464-D7",
      "text": "Products reviewed by the PDAC which do not meet the DME benefit category requirements must be coded as A9276, A9277, A9278, or A9279 and will be denied as non-covered (no Medicare Benefit)."
    },
    {
      "id": "A52464-D8",
      "text": "Alcohol or peroxide (codes A4244, A4245), betadine or hexachlorophene (pHisohex) (codes A4246, A4247) are non-covered since these items are not required for the proper functioning of the device."
    },
    {
      "id": "A52464-D9",
      "text": "Urine test reagent strips or tablets (code A4250) are non-covered since they are not used with a glucose monitor."
    },
    {
      "id": "A52464-D10",
      "text": "Reflectance colorimeter devices used for measuring blood glucose levels in clinical settings are not covered as durable medical equipment for use in the home because their need for frequent professional re-calibration makes them unsuitable for home use."
    },
    {
      "id": "A52464-D11",
      "text": "Glucose monitors that are not designed for use in the home must be coded A9270 and will be denied as statutorily non-covered (no benefit category)."
    },
    {
      "id": "A52464-D12",
      "text": "Home blood glucose disposable monitors, including test strips (code A9275) are non-covered because these monitors do not meet the definition of DME."
    },
    {
      "id": "A52464-D13",
      "text": "Claims for the specified items subject to Final Rule 1713 (84 Fed. Reg Vol 217) that do not meet the face-to-face encounter and WOPD requirements specified in the LCD-related Standard Documentation Requirements Article (A55426) will be denied as not reasonable and necessary."
    },
    {
      "id": "A52464-D14",
      "text": "If a supplier delivers an item prior to receipt of a WOPD, it will be denied as not reasonable and necessary."
    },
    {
      "id": "A52464-D15",
      "text": "If the WOPD is not obtained prior to delivery, payment will not be made for that item even if a WOPD is subsequently obtained by the supplier."
    },
    {
      "id": "A52464-D16",
      "text": "Claim lines billed without a KF modifier will be rejected as missing information."
    }
  ],
